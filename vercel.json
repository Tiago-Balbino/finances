{
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api-finances-alpha.vercel.app/api/:path*" },
    { "source": "/health", "destination": "https://api-finances-alpha.vercel.app/health" },
    { "source": "/((?!assets/|icons/|sw\\.js|manifest\\.webmanifest).*)", "destination": "/index.html" }
  ]
}
